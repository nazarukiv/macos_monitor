<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nazarukiv.macos_monitor.ui.ProcessDetailsController">
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
  </padding>

  <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Process Details"/>

  <GridPane hgap="12.0" vgap="10.0">
    <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
    <Label fx:id="nameLabel" maxWidth="Infinity" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

    <Label text="PID:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
    <Label fx:id="pidLabel" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

    <Label text="CPU:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
    <Label fx:id="cpuLabel" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

    <Label text="Memory:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
    <Label fx:id="memoryLabel" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

    <Label text="Threads:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
    <Label fx:id="threadsLabel" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

    <Label text="Uptime:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
    <Label fx:id="uptimeLabel" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

    <Label text="Path:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
    <Label fx:id="pathLabel" maxWidth="Infinity" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
  </GridPane>
</VBox>
