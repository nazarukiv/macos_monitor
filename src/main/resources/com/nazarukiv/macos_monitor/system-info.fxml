<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nazarukiv.macos_monitor.ui.SystemInfoController">
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
  </padding>

  <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="System Information"/>

  <GridPane hgap="12.0" vgap="10.0">
    <Label text="CPU name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
    <Label fx:id="cpuNameLabel" maxWidth="Infinity" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

    <Label text="OS:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
    <Label fx:id="osLabel" maxWidth="Infinity" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

    <Label text="Total RAM:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
    <Label fx:id="totalRamLabel" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

    <Label text="Available RAM:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
    <Label fx:id="availableRamLabel" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

    <Label text="Uptime:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
    <Label fx:id="uptimeLabel" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

    <Label text="Disk total:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
    <Label fx:id="diskTotalLabel" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

    <Label text="Disk free:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
    <Label fx:id="diskFreeLabel" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
  </GridPane>
</VBox>
